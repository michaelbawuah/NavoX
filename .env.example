# Runtime
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# Data and durable workflows (local Docker defaults)
DATABASE_URL=postgresql+asyncpg://navox:navox@localhost:5432/navox
TEMPORAL_TARGET=localhost:7233
TEMPORAL_TASK_QUEUE=navox-foundation

# Browser application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
WEB_ORIGIN=http://localhost:3000

# Milestone 1 session settings
SESSION_COOKIE_NAME=navox_session
SESSION_TTL_HOURS=168

# Google OAuth is added in a later Milestone 1 slice. Set these only through protected
# secret storage, never commit values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
