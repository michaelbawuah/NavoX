# Runtime
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# Data and durable workflows (local Docker defaults)
DATABASE_URL=postgresql+asyncpg://navox:navox@localhost:5432/navox
TEMPORAL_TARGET=localhost:7233
TEMPORAL_TASK_QUEUE=navox-foundation

# Browser application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Phase 1 only: set these through protected secret storage, never commit values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

