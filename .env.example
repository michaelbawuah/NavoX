# Runtime
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# Data and durable workflows (local Docker defaults)
DATABASE_URL=postgresql+asyncpg://navox:navox@localhost:5432/navox
TEMPORAL_TARGET=localhost:7233
TEMPORAL_TASK_QUEUE=navox-agent

# Browser application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
WEB_ORIGIN=http://localhost:3000

# Milestone 1 session settings
SESSION_COOKIE_NAME=navox_session
SESSION_TTL_HOURS=168

# Google OAuth: configure values locally or through protected deployment secret storage.
# The redirect URI must exactly match the Google Cloud OAuth client configuration.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Milestone 2 Google event delivery. Leave blank until the public HTTPS webhook and
# Google Cloud Pub/Sub subscription are configured. These values are deployment secrets.
GOOGLE_GMAIL_PUSH_SUBSCRIPTION=
GOOGLE_PUBSUB_PUSH_AUDIENCE=
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
GOOGLE_GMAIL_PUSH_VERIFICATION_TOKEN=

# Milestone 3 extraction policy. Candidates at or above the high threshold are
# quietly confirmed; candidates at or above the moderate threshold await review.
COMMITMENT_MODERATE_CONFIDENCE_THRESHOLD=0.65
COMMITMENT_HIGH_CONFIDENCE_THRESHOLD=0.85


# Milestone 5 bounded agent
# Safety limits (8 steps / 2 replans / R0-R1 automatic execution) are code-level
# policy invariants and are intentionally not configurable by environment variables.
