FROM node:24-alpine AS base
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/assistant-runtime/package.json packages/assistant-runtime/package.json
RUN npm ci

COPY . .
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_NAVOX_NEWS_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_SUBSCRIPTIONS_ENABLED=false
ENV NEXT_PUBLIC_NAVOX_NEWS_ENABLED=$NEXT_PUBLIC_NAVOX_NEWS_ENABLED
ENV NEXT_PUBLIC_NAVOX_SUBSCRIPTIONS_ENABLED=$NEXT_PUBLIC_NAVOX_SUBSCRIPTIONS_ENABLED
ARG NEXT_PUBLIC_NAVOX_STUDENT_PLANNING_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_LMS_FEEDS_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_COURSEWORK_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_RECOVERY_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_EMAIL_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_COACH_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_GOALS_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_WORK_EXPORT_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_AGENT_ENABLED=false
ARG NEXT_PUBLIC_NAVOX_STUDENT_AGENT_TOOL_CONTEXT_ENABLED=false
ENV NEXT_PUBLIC_NAVOX_STUDENT_PLANNING_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_PLANNING_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_LMS_FEEDS_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_LMS_FEEDS_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_COURSEWORK_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_COURSEWORK_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_RECOVERY_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_RECOVERY_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_EMAIL_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_EMAIL_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_COACH_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_COACH_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_GOALS_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_GOALS_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_WORK_EXPORT_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_WORK_EXPORT_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_AGENT_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_AGENT_ENABLED
ENV NEXT_PUBLIC_NAVOX_STUDENT_AGENT_TOOL_CONTEXT_ENABLED=$NEXT_PUBLIC_NAVOX_STUDENT_AGENT_TOOL_CONTEXT_ENABLED
RUN npm run build --workspace=@navox/web

EXPOSE 3000
CMD ["npm", "run", "start", "--workspace=@navox/web"]
